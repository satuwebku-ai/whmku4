APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Untuk lokal HTTP, biarkan false. Ubah ke true pada produksi HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Isi hanya alamat IP/CIDR reverse proxy yang benar-benar Anda percaya.
TRUSTED_PROXIES=

# CSP mulai dalam mode laporan; tinjau log CSP sebelum menerapkan kebijakan ketat.
CSP_REPORT_ONLY=true

# Kunci penandatangan backup (opsional, min. 32 byte). Kosong = pakai APP_KEY.
# Buat: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Saat rotasi: pindahkan kunci lama ke *_PREVIOUS (pisahkan koma).
BACKUP_SIGNING_KEY=
BACKUP_SIGNING_KEY_PREVIOUS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengaturan email juga bisa diisi dari panel admin (Pengaturan → Email) dan
# disimpan di database; nilai di sana menimpa MAIL_* di bawah ini.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Akun admin awal untuk `php artisan db:seed` (kosongkan ADMIN_PASSWORD = dibuatkan password acak)
ADMIN_EMAIL=
ADMIN_PASSWORD=
