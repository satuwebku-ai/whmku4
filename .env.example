
APP_NAME="Lumora Hosting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://satucloudhosting.com

PUBLIC_DOMAIN=satucloudhosting.com
ADMIN_DOMAIN=pengelola.satucloudhosting.com
CLIENT_DOMAIN=member.satucloudhosting.com
GOOGLE_REDIRECT_URI=https://member.satucloudhosting.com/auth/google/callback

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database
# Sesuaikan dengan database yang benar-benar digunakan.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE_CPANEL
DB_USERNAME=ISI_USERNAME_DATABASE_CPANEL
DB_PASSWORD="ISI_PASSWORD_DATABASE"

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Reverse proxy
TRUSTED_PROXIES=

# Content Security Policy
CSP_REPORT_ONLY=true

# Backup signing
BACKUP_SIGNING_KEY=
BACKUP_SIGNING_KEY_PREVIOUS=

# Broadcast
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Queue
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=file

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@satucloudhosting.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (opsional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# Admin Seeder
ADMIN_EMAIL=
ADMIN_PASSWORD=